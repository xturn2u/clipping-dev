{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalShorts",
  "version": "0.1.0",
  "identifier": "de.xturn2u.localshorts",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "LocalShorts",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:17891; media-src 'self' http://127.0.0.1:17891 blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "externalBin": [
      "binaries/localshorts-sidecar"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
